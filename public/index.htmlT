<!DOCTYPE html>
<html>
<head>
  <title>SMS Automation SaaS</title>
  <style>
    body { font-family: Arial; text-align: center; padding: 50px; background: #f0f0f0; }
    .pricing { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; margin: 30px 0; }
    .card { background: white; border-radius: 8px; padding: 30px; box-shadow: 0 2px 10px; min-width: 250px; }
    .price { font-size: 24px; color: #007bff; font-weight: bold; }
    button { padding: 12px 30px; background: #007bff; color: white; border: none; border-radius: 5px; cursor: pointer; }
  </style>
</head>
<body>
  <h1>📱 SMS Automation for Shopkeepers</h1>
  <p>Send 100+ SMS daily automatically!</p>
  
  <div class="pricing">
    <div class="card">
      <h2>Starter</h2>
      <div class="price">₹299/month</div>
      <p>50 SMS per day</p>
      <button>Get Started</button>
    </div>
    
    <div class="card">
      <h2>Pro</h2>
      <div class="price">₹999/month</div>
      <p>200 SMS per day</p>
      <button>Get Started</button>
    </div>
    
    <div class="card">
      <h2>Premium</h2>
      <div class="price">₹2999/month</div>
      <p>Unlimited SMS</p>
      <button>Get Started</button>
    </div>
  </div>
</body>
</html>
